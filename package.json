{
  "name": "mock-saml",
  "version": "1.5.0",
  "description": "Mock SAML is a free SAML 2.0 Identity Provider for testing SAML SSO integrations.",
  "private": true,
  "license": "Apache 2.0",
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint -c eslint.config.cjs ./",
    "test": "tsx --test --import ./tests/setup.ts 'tests/**/*.test.ts'",
    "test:e2e": "playwright test",
    "check-format": "prettier --check .",
    "format": "prettier --write .",
    "release": "git checkout release && git merge origin/main && release-it && git checkout main && git merge origin/release && git push origin main"
  },
  "dependencies": {
    "@boxyhq/saml20": "3.2.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "node-mocks-http": "1.18.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "release-it": "21.1.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
